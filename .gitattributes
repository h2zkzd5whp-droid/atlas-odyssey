# Normalize all text files to LF in the repo and in the working tree,
# regardless of core.autocrlf (Windows Git has it set to true system-wide).
* text=auto eol=lf

# Windows-only scripts need CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: no line-ending conversion, no text diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.pptx binary
*.docx binary
*.ttf  binary
*.woff binary
*.woff2 binary
